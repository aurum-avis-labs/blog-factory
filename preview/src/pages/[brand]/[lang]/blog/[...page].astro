---
/**
 * Blog listing for a brand's non-default language.
 * URL: /{brand}/{lang}/blog/
 */
import type { GetStaticPaths } from "astro";
import BlogListing from "@/components/BlogListing.astro";
import { listingPaths } from "@/lib/listing";
import { getCollection } from "astro:content";

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);
  return listingPaths(paginate, allPosts, {
    defaultLanguageOnly: false,
    scopedSite: false,
  });
}) satisfies GetStaticPaths;

const { page, brandId, brandName, lang, siteId } = Astro.props;
---

<BlogListing
  page={page}
  brandId={brandId}
  brandName={brandName}
  lang={lang}
  siteId={siteId}
/>
