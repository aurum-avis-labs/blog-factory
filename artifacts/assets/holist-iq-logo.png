lass="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&#38;_svg]:pointer-events-none [&#38;_svg:not([class*='size-'])]:size-4 shrink-0 [&#38;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive border bg-background shadow-xs hover:bg-accent hover:text-accent-foreground dark:bg-input/30 dark:border-input dark:hover:bg-input/50 h-8 rounded-md gap-1.5 px-3 has-[>svg]:px-2.5 w-full sm:flex-1" data-astro-cid-fzbxxtek> Decline </button> <button id="cookie-accept-btn" class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&#38;_svg]:pointer-events-none [&#38;_svg:not([class*='size-'])]:size-4 shrink-0 [&#38;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive bg-primary text-primary-foreground shadow-xs hover:bg-primary/90 h-8 rounded-md gap-1.5 px-3 has-[>svg]:px-2.5 w-full sm:flex-1" data-astro-cid-fzbxxtek> Accept All </button> </div> </div> </div> <!-- Cookie Settings Dialog --> <dialog id="cookie-settings-dialog" class="fixed inset-0 z-[60] bg-transparent p-4 m-0 max-w-none max-h-none w-full h-full" data-astro-cid-fzbxxtek> <div class="fixed inset-0 bg-black/50 backdrop-blur-sm" id="dialog-backdrop" data-astro-cid-fzbxxtek></div> <div class="fixed left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-lg bg-background rounded-lg shadow-xl border border-border" data-astro-cid-fzbxxtek> <!-- Dialog Header --> <div class="p-6 pb-4" data-astro-cid-fzbxxtek> <h2 class="text-lg font-semibold flex items-center gap-2" data-astro-cid-fzbxxtek> <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" data-astro-cid-fzbxxtek> <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" data-astro-cid-fzbxxtek></path> <circle cx="12" cy="12" r="3" data-astro-cid-fzbxxtek></circle> </svg> Cookie Preferences </h2> <p class="text-sm text-muted-foreground mt-2" data-astro-cid-fzbxxtek> Customize your cookie preferences. Essential cookies cannot be disabled as they are required for the website to function properly. </p> </div> <!-- Cookie Categories --> <div class="px-6 space-y-4" data-astro-cid-fzbxxtek> <!-- Essential Cookies --> <div class="flex items-start gap-3 p-3 rounded-lg border" data-astro-cid-fzbxxtek> <svg class="h-5 w-5 text-primary mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" data-astro-cid-fzbxxtek> <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" data-astro-cid-fzbxxtek></path> </svg> <div class="flex-1 min-w-0" data-astro-cid-fzbxxtek> <div class="flex items-center justify-between gap-2" data-astro-cid-fzbxxtek> <h4 class="font-medium text-sm" data-astro-cid-fzbxxtek>Essential Cookies</h4> <div class="relative inline-flex h-5 w-9 items-center rounded-full bg-primary cursor-not-allowed opacity-70" data-astro-cid-fzbxxtek> <span class="inline-block h-4 w-4 transform rounded-full bg-white translate-x-4" data-astro-cid-fzbxxtek></span> </div> </div> <p class="text-xs text-muted-foreground mt-1" data-astro-cid-fzbxxtek>Required for basic website functionality, security, user authentication, and error tracking.</p> <p class="text-xs text-orange-500 mt-1" data-astro-cid-fzbxxtek>Always active</p> </div> </div> <!-- Analytics Cookies --> <div class="flex items-start gap-3 p-3 rounded-lg border" data-astro-cid-fzbxxtek> <svg class="h-5 w-5 text-primary mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" data-astro-cid-fzbxxtek> <path d="M3 3v18h18" data-astro-cid-fzbxxtek></path><path d="m19 9-5 5-4-4-3 3" data-astro-cid-fzbxxtek></path> </svg> <div class="flex-1 min-w-0" data-astro-cid-fzbxxtek> <div class="flex items-center justify-between gap-2" data-astro-cid-fzbxxtek> <h4 class="font-medium text-sm" data-astro-cid-fzbxxtek>Analytics Cookies</h4> <button type="button" id="toggle-analytics" role="switch" aria-checked="false" class="cookie-toggle relative inline-flex h-5 w-9 items-center rounded-full bg-muted transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" data-category="analytics" data-astro-cid-fzbxxtek> <span class="toggle-thumb inline-block h-4 w-4 transform rounded-full bg-white shadow-sm transition-transform translate-x-0.5" data-astro-cid-fzbxxtek></span> </button> </div> <p class="text-xs text-muted-foreground mt-1" data-astro-cid-fzbxxtek>Help us understand how visitors interact with our website to improve user experience. Includes Google Analytics and Microsoft Clarity session recordings.</p> </div> </div> <!-- Marketing Cookies --> <div class="flex items-start gap-3 p-3 rounded-lg border" data-astro-cid-fzbxxtek> <svg class="h-5 w-5 text-primary mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" data-astro-cid-fzbxxtek> <circle cx="12" cy="12" r="10" data-astro-cid-fzbxxtek></circle><circle cx="12" cy="12" r="6" data-astro-cid-fzbxxtek></circle><circle cx="12" cy="12" r="2" data-astro-cid-fzbxxtek></circle> </svg> <div class="flex-1 min-w-0" data-astro-cid-fzbxxtek> <div class="flex items-center justify-between gap-2" data-astro-cid-fzbxxtek> <h4 class="font-medium text-sm" data-astro-cid-fzbxxtek>Marketing Cookies</h4> <button type="button" id="toggle-marketing" role="switch" aria-checked="false" class="cookie-toggle relative inline-flex h-5 w-9 items-center rounded-full bg-muted transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" data-category="marketing" data-astro-cid-fzbxxtek> <span class="toggle-thumb inline-block h-4 w-4 transform rounded-full bg-white shadow-sm transition-transform translate-x-0.5" data-astro-cid-fzbxxtek></span> </button> </div> <p class="text-xs text-muted-foreground mt-1" data-astro-cid-fzbxxtek>Used to track visitors across websites to display relevant and engaging advertisements.</p> </div> </div> </div> <!-- Dialog Footer --> <div class="p-6 pt-4 flex gap-2 justify-end" data-astro-cid-fzbxxtek> <button id="cookie-settings-cancel" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&#38;_svg]:pointer-events-none [&#38;_svg:not([class*='size-'])]:size-4 shrink-0 [&#38;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive border bg-background shadow-xs hover:bg-accent hover:text-accent-foreground dark:bg-input/30 dark:border-input dark:hover:bg-input/50 h-9 px-4 py-2 has-[>svg]:px-3" data-astro-cid-fzbxxtek> Cancel </button> <button id="cookie-settings-save" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&#38;_svg]:pointer-events-none [&#38;_svg:not([class*='size-'])]:size-4 shrink-0 [&#38;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive bg-primary text-primary-foreground shadow-xs hover:bg-primary/90 h-9 px-4 py-2 has-[>svg]:px-3" data-astro-cid-fzbxxtek> Save Preferences </button> </div> </div> </dialog>  <script type="module" src="/_astro/CookieBanner.astro_astro_type_script_index_0_lang.DC3TSPER.js"></script> <!-- Application Insights — loaded only after analytics consent --> <script type="module" src="/_astro/BaseLayout.astro_astro_type_script_index_0_lang.D5L37BaZ.js"></script> <!-- Smooth scrolling for hash links --> <script>
      document.addEventListener('DOMContentLoaded', function() {
        const navLinks = document.querySelectorAll('a[href^="#"]');
        
        navLinks.forEach(link => {
          link.addEventListener('click', function(e) {
            const target = e.currentTarget;
            const href = target.getAttribute('href');
            
            // Only handle hash links for smooth scrolling
            if (href && href.startsWith('#')) {
              e.preventDefault();
              const element = document.querySelector(href);
              
              if (element) {
                // Update URL with hash
                history.pushState(null, '', href);
                
                // Smooth scroll to element
                element.scrollIntoView({ 
                  behavior: 'smooth',
                  block: 'start'
                });
                if (element instanceof HTMLElement && element.hasAttribute('tabindex')) {
                  window.setTimeout(function () {
                    try { element.focus({ preventScroll: true }); } catch (e) {}
                  }, 400);
                }
              }
            }
          });
        });
      });
    </script> <script type="module" src="/_astro/BaseLayout.astro_astro_type_script_index_1_lang.CaR8zqZu.js"></script> </body> </html>